            ],
            "url": {
              "raw": "{{base_url}}/api/patients?page=1&limit=10&search=",
              "host": ["{{base_url}}"],
              "path": ["api", "patients"],
              "query": [
                { "key": "page", "value": "1", "description": "Nomor halaman (default: 1)" },
                { "key": "limit", "value": "10", "description": "Jumlah data per halaman (default: 10)" },
                { "key": "search", "value": "", "description": "Kata kunci pencarian (NIK, Nama, atau No. RM)" }
              ]
            },
            "description": "Mendapatkan daftar seluruh pasien dengan pagination dan fitur pencarian."
          },
          "response": []
        },
        {
          "name": "Get Patient by ID",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
