              "raw": "{{base_url}}/api/patients/1",
              "host": ["{{base_url}}"],
              "path": ["api", "patients", "1"]
            },
            "description": "Mendapatkan detail data satu pasien berdasarkan ID."
          },
          "response": []
        },
        {
          "name": "Create Patient",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"nik\": \"3201234567890001\",\n    \"name\": \"Budi Santoso\",\n    \"gender\": \"Laki-laki\",\n    \"birth_date\": \"1990-05-15\",\n    \"phone_number\": \"081234567890\",\n    \"address\": \"Jl. Merdeka No. 10, Jakarta Selatan\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/patients",
              "host": ["{{base_url}}"],
              "path": ["api", "patients"]
            },
            "description": "Menambahkan data pasien baru. No. Rekam Medis (RM) akan di-generate otomatis oleh sistem dengan format RM-YYYYMMDD-XXX."
          },
          "response": []
        },
        {
          "name": "Update Patient",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"nik\": \"3201234567890001\",\n    \"name\": \"Budi Santoso Updated\",\n    \"gender\": \"Laki-laki\",\n    \"birth_date\": \"1990-05-15\",\n    \"phone_number\": \"089876543210\",\n    \"address\": \"Jl. Sudirman No. 5, Jakarta Pusat\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/patients/1",
              "host": ["{{base_url}}"],
              "path": ["api", "patients", "1"]
            },
            "description": "Memperbarui data pasien berdasarkan ID."
          },
          "response": []
        },
        {
          "name": "Delete Patient",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/patients/1",
              "host": ["{{base_url}}"],
              "path": ["api", "patients", "1"]
            },
            "description": "Menghapus data pasien berdasarkan ID. (Hati-hati: data pasien yang terhapus tidak bisa dikembalikan)"
          },
          "response": []
        }
      ]
